PORT=5000
# Use 127.0.0.1 rather than localhost to avoid IPv6/IPv4 resolution issues
# with local MongoDB installations that only bind to IPv4.
MONGO_URI=mongodb://127.0.0.1:27017/flipkart-clone
JWT_SECRET=<replace_with_a_long_random_string>
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# Optional — only required if you enable Cloudinary-based image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — only required if you enable transactional email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shopkart.example.com
